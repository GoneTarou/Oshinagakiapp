<% content_for :title, "即売会しおり" %>

<div
  class="min-h-screen w-full bg-[#f5af58] bg-cover bg-center bg-no-repeat px-5 py-10 text-white"
  style="background-image: url('<%= asset_path("sikakuf8.png") %>');"
>
  <div class="mx-auto flex min-h-[80vh] w-full max-w-3xl items-center justify-center">
    <main class="w-full pt-12 text-center sm:pt-16">
      <h1 class="app-name text-5xl font-normal tracking-[0.08em] text-white sm:text-7xl">
        即売会しおり
      </h1>

      <p class="mt-5 text-base font-semibold text-white sm:text-lg">
        同人イベントの巡回リストを作成・共有
      </p>

      <p class="mt-2 font-mono text-xs tracking-[0.12em] text-white">
        DOJIN EVENT MEMO
      </p>

      <div class="mt-10 flex flex-col items-center justify-center gap-4 lg:flex-row">
        <%= link_to "使い方を確認する",
              how_to_path,
              class: "inline-flex min-h-20 w-full cursor-pointer items-center justify-center whitespace-nowrap rounded-full border-2 border-white bg-white px-6 text-lg font-bold text-[#f5af58] transition hover:border-[#ededed] hover:bg-[#ededed] hover:text-[#f5af58] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white lg:min-h-24 lg:w-[23rem] lg:px-8 lg:text-2xl" %>

        <%= link_to new_list_path(reset_draft: 1),
              class: "inline-flex min-h-20 w-full cursor-pointer items-center justify-center whitespace-nowrap rounded-full border-2 border-white bg-white px-6 text-lg font-bold text-[#f5af58] transition hover:border-[#ededed] hover:bg-[#ededed] hover:text-[#f5af58] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white lg:min-h-24 lg:w-[23rem] lg:px-8 lg:text-2xl" do %>
          ＋ 新しい巡回リストを作る
        <% end %>
      </div>

      <section
        class="mx-auto mt-16 max-w-2xl rounded-xl border-2 border-white bg-white px-5 py-8 sm:px-8"
        aria-labelledby="home-notice-title"
      >
        <h2 id="home-notice-title" class="text-base font-bold text-[#f5af58] sm:text-lg">
          巡回したいサークルのお品書きポストを登録してXで共有しましょう!<br>
        </h2>

        <ul class="mx-auto mt-5 max-w-xl list-disc space-y-2 text-left text-sm leading-7 text-[#f5af58]">
          <li>自分が購入したいサークルの情報をフォロワーに共有できます</li>
          <li>Xのお品書きポストのURLを入力するとプレビューが表示され、確認することができます</li>
          <li>リストを作成すると共有URLが発行されます</li>
        </ul>

      </section>

      <p class="mt-7 font-mono text-xs text-white/80">
        © 即売会しおり
      </p>
    </main>
  </div>
</div>
