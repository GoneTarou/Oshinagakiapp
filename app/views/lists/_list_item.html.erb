<% space_label = item.space_number.presence %>

<% card_content = capture do %>
  <article class="card card-compact bg-base-100 shadow-sm">
    <div class="card-body gap-4 p-4">
      <div class="flex flex-wrap items-center gap-2">
        <% if space_label.present? %>
          <span class="badge badge-error badge-lg font-bold"><%= space_label %></span>
        <% end %>

        <% if item.is_featured? %>
          <span class="badge badge-warning">👑 イチ推し</span>
        <% end %>

        <% if item.is_adult_content? %>
          <span class="badge badge-neutral">🔞 成人向け</span>
        <% end %>
      </div>

      <% if item.source_url.present? %>
        <div
          data-controller="external-post"
          data-external-post-url-value="<%= item.source_url %>"
          data-external-post-pixiv-title-url-value="<%= list_item_pixiv_title_path(item.list.token, item.id) %>"
          data-external-post-adult-value="<%= item.is_adult_content? %>">
          <p
            data-external-post-target="title"
            class="mb-3 text-center font-semibold"
            hidden>
          </p>

          <div class="flex justify-center">
            <div data-external-post-target="content" hidden></div>
          </div>

          <div class="flex justify-center" data-external-post-target="fallback">
            <%= link_to (item.pixiv_source? ? "pixivで開く" : "外部ポストを開く"), item.source_url,
                  class: "btn btn-secondary btn-sm",
                  target: "_blank",
                  rel: "noopener noreferrer" %>
          </div>

          <p
            data-external-post-target="error"
            class="text-sm text-error"
            role="alert"
            hidden>
          </p>
        </div>
      <% else %>
        <p class="text-sm text-base-content/60">外部ポストURLは登録されていません。</p>
      <% end %>
    </div>
  </article>
<% end %>

<% if item.is_adult_content? %>
  <details class="group">
    <summary class="flex min-h-32 cursor-pointer list-none items-center justify-center rounded-xl border border-base-content/20 bg-base-100 p-4 text-center shadow-sm transition hover:shadow-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-secondary group-open:hidden">
      <span>
        <span class="block font-semibold">🔞 成人向け</span>
        <% if space_label.present? %>
          <span class="mt-2 block text-sm text-base-content/70">配置：<%= space_label %></span>
        <% end %>
        <span class="btn btn-secondary btn-sm mt-4">成人向けコンテンツを表示</span>
      </span>
    </summary>
    <div class="mt-4">
      <%= card_content %>
    </div>
  </details>
<% else %>
  <%= card_content %>
<% end %>
