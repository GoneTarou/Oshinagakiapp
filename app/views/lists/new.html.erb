<% content_for :title, "巡回リストを作成" %>

<div class="w-full max-w-3xl mx-auto py-8">
  <div class="mb-8">
    <p class="text-sm font-semibold text-secondary">即売会巡回リスト</p>
    <h1 class="mt-2 text-3xl font-bold text-base-content">巡回リストを作成</h1>
    <p class="mt-3 text-base text-base-content/70">
      イベントと巡回先を登録して、共有用のリストを作成します。
    </p>
  </div>

  <%= form_with model: @list, url: lists_path, class: "space-y-8" do |form| %>
    <section class="card bg-base-100 shadow-sm">
      <div class="card-body">
        <h2 class="card-title">イベント</h2>

        <div>
          <%= form.label :event_id, "イベント", class: "label" do %>
            <span class="label-text font-semibold">イベント <span class="text-error">必須</span></span>
          <% end %>
          <%= form.collection_select :event_id, @events, :id, :name,
                { prompt: "イベントを選択してください" },
                { class: "select select-bordered w-full", required: true } %>
          <% @list.errors.where(:event).each do |error| %>
            <p class="mt-2 text-sm text-error" role="alert"><%= error.full_message %></p>
          <% end %>
        </div>

        <div>
          <%= form.label :event_occurrence_id, "開催回", class: "label" do %>
            <span class="label-text font-semibold">開催回</span>
          <% end %>
          <%= form.collection_select :event_occurrence_id, @events.flat_map(&:event_occurrences), :id,
                ->(occurrence) { "#{occurrence.event.name} #{occurrence.number}" },
                { prompt: "開催回を選択してください（その他は不要）" },
                { class: "select select-bordered w-full" } %>
          <% @list.errors.where(:event_occurrence).each do |error| %>
            <p class="mt-2 text-sm text-error" role="alert"><%= error.full_message %></p>
          <% end %>
          <p class="mt-2 text-sm text-base-content/60">「その他」を選択した場合、開催回は選択しません。</p>
        </div>
      </div>
    </section>

    <section class="card bg-base-100 shadow-sm">
      <div class="card-body">
        <div>
          <h2 class="card-title">巡回先</h2>
          <p class="mt-2 text-sm text-base-content/70">最大20件まで登録できます。配置番号と外部ポストURLは任意です。</p>
          <% @list.errors.where(:list_items).each do |error| %>
            <p class="mt-2 text-sm text-error" role="alert"><%= error.full_message %></p>
          <% end %>
        </div>

        <div class="space-y-4">
          <% 5.times do |index| %>
            <% item = @list.list_items[index] || @list.list_items.build %>
            <div class="rounded-xl border border-base-300 bg-base-200/30 p-4">
              <%= form.fields_for :list_items, item, child_index: index do |item_form| %>
                <%= render "lists/list_item_fields", item_form: item_form, index: index %>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </section>

    <div class="flex justify-end">
      <%= form.submit "巡回リストを作成", class: "btn btn-primary min-h-12 px-6 text-base" %>
    </div>
  <% end %>
</div>
