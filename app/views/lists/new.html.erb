<% content_for :title, "巡回リストを作成 | 即売会しおり" %>

<div class="min-h-screen w-full bg-[#f5af58] px-5 py-10 text-white">
  <div
    class="mx-auto w-full max-w-3xl"
    data-controller="list-tutorial"
    data-list-tutorial-storage-key-value="oshinagaki:list-tutorial:v1"
  >
    <dialog
      class="modal"
      aria-labelledby="list-tutorial-title"
      data-list-tutorial-target="dialog"
      data-action="cancel->list-tutorial#skip"
    >
      <div class="modal-box flex h-[90vh] max-h-[calc(100vh-2rem)] w-11/12 max-w-4xl flex-col border-2 border-[#f5af58] bg-white p-0 text-base-content">
        <div class="bg-[#f5af58] px-6 py-4 text-white">
          <p
            class="text-sm font-bold tracking-wide"
            data-list-tutorial-target="progress"
          ></p>
        </div>

        <div class="flex min-h-0 flex-1 flex-col p-6 sm:p-8">
          <section class="flex min-h-0 flex-1 flex-col" data-list-tutorial-target="step">
            <p class="text-sm font-bold text-[#f5af58]">STEP 1</p>
            <h2 id="list-tutorial-title" class="mt-2 text-2xl font-bold">
              イベントを選ぶ
            </h2>
            <p class="mt-4 leading-7 text-base-content/70">
              参加する即売会を選択してください。
            </p>
            <div class="mt-5 min-h-0 flex-1">
              <%= image_tag "11.png",
                    alt: "イベントを選択する画面",
                    class: "h-full w-full rounded-lg border border-base-300 object-contain" %>
            </div>
          </section>

          <section class="flex min-h-0 flex-1 flex-col" data-list-tutorial-target="step" hidden>
            <p class="text-sm font-bold text-[#f5af58]">STEP 2</p>
            <h2 class="mt-2 text-2xl font-bold">
              巡回先を登録する
            </h2>
            <p class="mt-4 leading-7 text-base-content/70">
              Xの投稿URLまたはpixiv作品URLを入力します。メモは任意です。<br>
              成人向け作品にチェックマークを入れると、リストに成人向け作品として表示されます。
            </p>
            <div class="mt-5 min-h-0 flex-1">
              <%= image_tag "22.png",
                    alt: "巡回先を登録する画面",
                    class: "h-full w-full rounded-lg border border-base-300 object-contain" %>
            </div>
          </section>

          <section class="flex min-h-0 flex-1 flex-col" data-list-tutorial-target="step" hidden>
            <p class="text-sm font-bold text-[#f5af58]">STEP 3</p>
            <h2 class="mt-2 text-2xl font-bold">
              リストを作成して共有する
            </h2>
            <p class="mt-4 leading-7 text-base-content/70">
              「巡回リストを作成」を押すとリストが表示されます。
            </p>
            <div class="mt-5 min-h-0 flex-1">
              <%= image_tag "44.png",
                    alt: "リストを作成して共有する画面",
                    class: "h-full w-full rounded-lg border border-base-300 object-contain" %>
            </div>
          </section>

          <section class="flex min-h-0 flex-1 flex-col" data-list-tutorial-target="step" hidden>
            <p class="text-sm font-bold text-[#f5af58]">STEP 4</p>
            <h2 class="mt-2 text-2xl font-bold">
              既存のリストを活用して新しくリストを作る
            </h2>
            <p class="mt-4 leading-7 text-base-content/70">
              共有リストの内容を引き継いで、新しい巡回リストを作成できます。
            </p>
            <div class="mt-5 min-h-0 flex-1">
              <%= image_tag "55.png",
                    alt: "既存のリストを活用して新しくリストを作成する画面",
                    class: "h-full w-full rounded-lg border border-base-300 object-contain" %>
            </div>
          </section>

          <section class="flex min-h-0 flex-1 flex-col" data-list-tutorial-target="step" hidden>
            <p class="text-sm font-bold text-[#f5af58]">STEP 5</p>
            <h2 class="mt-2 text-2xl font-bold">
              Xに共有する
            </h2>
            <p class="mt-4 leading-7 text-base-content/70">
              「Xで共有する」を押すと、作成した巡回リストをXに共有できます。
            </p>
            <div class="mt-5 min-h-0 flex-1">
              <%= image_tag "46.jpg",
                    alt: "Xに巡回リストを共有する画面",
                    class: "h-full w-full rounded-lg border border-base-300 object-contain" %>
            </div>
          </section>

          <div class="mt-6 flex items-center justify-between gap-4">
            <button
              type="button"
              class="text-sm font-bold text-base-content/60 underline underline-offset-4 transition hover:text-[#f5af58]"
              data-action="click->list-tutorial#skip"
            >
              スキップ
            </button>

            <div class="flex items-center gap-2">
              <button
                type="button"
                class="inline-flex min-h-11 items-center justify-center rounded-full border-2 border-[#f5af58] bg-white px-5 font-bold text-[#f5af58] transition hover:bg-[#fff4e8]"
                data-list-tutorial-target="previousButton"
                data-action="click->list-tutorial#previous"
                hidden
              >
                戻る
              </button>

              <button
                type="button"
                class="inline-flex min-h-11 items-center justify-center rounded-full border-2 border-[#f5af58] bg-[#f5af58] px-6 font-bold text-white transition hover:bg-[#d98f3e]"
                data-list-tutorial-target="nextButton"
                data-action="click->list-tutorial#next"
              >
                次へ
              </button>

              <button
                type="button"
                class="inline-flex min-h-11 items-center justify-center rounded-full border-2 border-[#f5af58] bg-[#f5af58] px-6 font-bold text-white transition hover:bg-[#d98f3e]"
                data-list-tutorial-target="finishButton"
                data-action="click->list-tutorial#finish"
                hidden
              >
                はじめる
              </button>
            </div>
          </div>
        </div>
      </div>

      <form method="dialog" class="modal-backdrop">
        <button
          type="button"
          aria-label="チュートリアルを閉じる"
          data-action="click->list-tutorial#skip"
        >
          閉じる
        </button>
      </form>
    </dialog>

    <header class="relative mb-8 text-center">
      <div class="mb-5 flex justify-end sm:mb-0 sm:block">
        <button
          type="button"
          class="inline-flex min-h-11 items-center justify-center rounded-full border-2 border-white bg-white px-4 text-sm font-bold text-[#f5af58] transition hover:bg-[#f3f3f3] sm:absolute sm:bottom-0 sm:right-0"
          data-action="click->list-tutorial#open"
        >
          使い方を見る
        </button>
      </div>
      <p class="app-name text-4xl font-normal tracking-[0.08em] text-white sm:text-5xl">即売会しおり</p>
      <h1 class="mt-6 text-3xl font-bold text-white">巡回リストを作成</h1>
      <p class="mt-3 text-base text-white">
        イベントと巡回先を登録して、共有用のリストを作成します。
      </p>
    </header>

  <%= form_with model: @list,
        url: lists_path,
        class: "space-y-8",
        data: {
          controller: "featured-items list-draft",
          action: "input->list-draft#save change->list-draft#save",
          list_draft_reset_value: params[:reset_draft] == "1",
          turbo: false
        } do |form| %>
    <section class="card card-compact overflow-hidden bg-base-100 text-base-content shadow-sm">
      <div class="bg-white px-6 py-4 text-[#f5af58]">
        <h2 class="text-xl font-bold">1. イベント</h2>
      </div>

      <div class="card-body">
        <p class="mb-4 rounded-md bg-base-200/60 px-4 py-3 text-base font-bold text-base-content">
          ・イベントを選択してください。
        </p>

        <% if flash[:creation_rate_limit_error].present? %>
          <p class="mb-4 whitespace-pre-line rounded-md border border-error bg-error/10 px-4 py-3 text-sm font-bold text-error" role="alert"><%= flash[:creation_rate_limit_error] %></p>
        <% end %>

        <div>
          <%= form.label :event_id, "イベント", class: "label" do %>
            <span class="label-text font-semibold">イベント <span class="text-error">必須</span></span>
          <% end %>
          <%= form.collection_select :event_id, @events, :id, :name,
                { prompt: "イベントを選択してください" },
                { class: "select select-bordered w-full", required: true } %>
          <% @list.errors.where(:event).each do |error| %>
            <p class="mt-2 text-sm text-error" role="alert"><%= error.full_message %></p>
          <% end %>
        </div>

      </div>
    </section>

    <section
      class="card card-compact overflow-hidden bg-base-100 text-base-content shadow-sm"
      data-controller="list-items"
      data-action="list-draft:restored@window->list-items#restore"
    >
      <div class="bg-white px-6 py-4 text-[#f5af58]">
        <h2 class="text-xl font-bold">2. 巡回先リスト</h2>
      </div>

      <div class="card-body">
        <div>
          <p class="mb-4 rounded-md bg-base-200/60 px-4 py-3 text-base font-bold text-base-content">
            ・購入したいサークルの情報のXのポストのURLまたはpixiv作品のURLを入力してください。<br>
            ・イチ推しは１件のみ登録できます。
          </p>
          <p class="mt-2 text-sm text-base-content/70">
            ・メモと外部ポストURLは任意です。<br>
            ・どちらか一方の入力が必要です。最大20件まで登録できます。
          </p>
          <% @list.errors.where(:list_items).each do |error| %>
            <p class="mt-2 text-sm text-error" role="alert"><%= error.full_message %></p>
          <% end %>
          <% @list.errors.where(:base).each do |error| %>
            <p class="mt-2 whitespace-pre-line text-sm text-error" role="alert"><%= error.message %></p>
          <% end %>
        </div>

        <div class="space-y-4">
          <% 20.times do |index| %>
            <% item = @list.list_items[index] || @list.list_items.build %>

            <div
              class="rounded-xl border-2 border-base-300 bg-base-100 p-4 shadow-sm"
              data-list-items-target="item"
              data-controller="post-preview"
              <%= "hidden" if index >= 5 %>
            >
              <%= form.fields_for :list_items, item, child_index: index do |item_form| %>
                <%= render "lists/list_item_fields", item_form: item_form, index: index %>
              <% end %>
            </div>
          <% end %>
        </div>

        <button
          type="button"
          class="mx-auto mt-2 inline-flex min-h-12 items-center justify-center rounded-full border-2 border-[#f5af58] bg-[#f5af58] px-6 font-bold text-white transition hover:bg-[#d98f3e] hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-secondary"
          data-list-items-target="addButton"
          data-action="click->list-items#add"
        >
          巡回先を追加する
        </button>
      </div>
    </section>

    <div class="mt-8 flex justify-center">
      <%= form.submit "巡回リストを作成", class: "inline-flex min-h-20 min-w-64 cursor-pointer items-center justify-center rounded-full border-2 border-white bg-white px-16 text-xl font-bold text-[#f5af58] transition hover:border-[#ededed] hover:bg-[#ededed] hover:text-[#f5af58] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white" %>
    </div>
  <% end %>
  </div>
</div>
