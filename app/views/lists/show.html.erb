<% event_context = @list.event.name %>
<% content_for :title, "#{event_context} / 即売会しおり" %>
<% share_url = list_url(token: @list.token) %>
<% share_text = "#{event_context}の巡回リストを共有します #即売会しおり" %>
<% x_share_url = "https://twitter.com/intent/tweet?url=#{ERB::Util.url_encode(share_url)}&text=#{ERB::Util.url_encode(share_text)}" %>
<% ogp_image_url = list_ogp_url(token: @list.token) %>
<% ogp_description = "#{event_context}の巡回リスト" %>

<% content_for :head do %>
  <%= tag.meta name: "description", content: ogp_description %>
  <%= tag.meta property: "og:title", content: event_context %>
  <%= tag.meta property: "og:description", content: ogp_description %>
  <%= tag.meta property: "og:type", content: "website" %>
  <%= tag.meta property: "og:url", content: share_url %>
  <%= tag.meta property: "og:image", content: ogp_image_url %>
  <%= tag.meta property: "og:image:width", content: "1200" %>
  <%= tag.meta property: "og:image:height", content: "630" %>
  <%= tag.meta property: "og:image:alt", content: "#{event_context}の巡回リスト" %>
  <%= tag.meta property: "og:site_name", content: "即売会しおり" %>
  <%= tag.meta name: "twitter:card", content: "summary_large_image" %>
  <%= tag.meta name: "twitter:title", content: event_context %>
  <%= tag.meta name: "twitter:description", content: ogp_description %>
  <%= tag.meta name: "twitter:image", content: ogp_image_url %>
<% end %>

<div class="min-h-screen w-full bg-[#f5af58] px-5 py-10 text-white">
  <div class="mx-auto w-full max-w-3xl">
    <header class="mb-8 text-center">
      <p class="app-name text-4xl font-normal tracking-[0.08em] text-white sm:text-5xl">即売会しおり</p>
      <h1 class="mt-6 text-3xl font-bold text-white"><%= event_context %></h1>
      <div class="mt-5 flex flex-wrap gap-3">
        <%= link_to "Xで共有する",
              x_share_url,
              class: "inline-flex min-h-12 items-center justify-center rounded-full border-2 border-white bg-white px-7 text-base font-bold text-[#f5af58] transition hover:bg-white/90 hover:text-[#f5af58] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white",
              target: "_blank",
              rel: "noopener noreferrer" %>
      </div>
    </header>

    <main>
      <% if @list_items.empty? %>
        <section class="card card-compact bg-base-100 text-base-content shadow-sm">
          <div class="card-body items-center py-12 text-center">
            <h2 class="card-title">巡回先がありません</h2>
            <p class="text-base-content/70">登録された巡回先を確認できません。</p>
          </div>
        </section>
      <% else %>
        <div class="mx-auto flex w-full max-w-2xl flex-col gap-4">
          <% @list_items.each do |item| %>
            <%= render "lists/list_item", item: item %>
          <% end %>
        </div>
      <% end %>
    </main>
  </div>
</div>
