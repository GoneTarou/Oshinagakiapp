<div class="mb-4 flex items-center justify-between gap-4">
  <h3 class="font-semibold">巡回先 <%= index + 1 %></h3>
  <span class="badge badge-ghost"><%= index + 1 %> / 20</span>
</div>

<div class="grid gap-4 sm:grid-cols-2">
  <div>
    <%= item_form.label :space_number, "作者名またはサークル情報", class: "label" do %>
      <span class="label-text">作者名またはサークル情報 <span class="text-base-content/60">(任意)</span></span>
    <% end %>
    <%= item_form.text_field :space_number,
          placeholder: "例：サークル名、作者名、東A-12b",
          class: "input input-bordered w-full#{" input-error" if item_form.object.errors[:space_number].any?}",
          aria: { invalid: item_form.object.errors[:space_number].any? } %>
    <% item_form.object.errors.where(:space_number).each do |error| %>
      <p class="mt-2 text-sm text-error" role="alert"><%= error.full_message %></p>
    <% end %>
  </div>

  <div>
    <%= item_form.label :source_url, "外部ポストURL（X・pixiv）", class: "label" do %>
      <span class="label-text">外部ポストURL（X・pixiv） <span class="text-base-content/60">(任意)</span></span>
    <% end %>
    <%= item_form.url_field :source_url,
          placeholder: "X・pixivなどのURL",
          class: "input input-bordered w-full#{" input-error" if item_form.object.errors[:source_url].any?}",
          aria: { invalid: item_form.object.errors[:source_url].any? } %>
    <% item_form.object.errors.where(:source_url).each do |error| %>
      <p class="mt-2 text-sm text-error" role="alert"><%= error.full_message %></p>
    <% end %>
  </div>
</div>

<div class="mt-4 flex flex-wrap gap-x-6 gap-y-3">
  <label class="label cursor-pointer justify-start gap-3">
    <%= item_form.check_box :is_featured, class: "checkbox checkbox-warning" %>
    <span class="label-text">👑 イチ推し</span>
  </label>

  <label class="label cursor-pointer justify-start gap-3">
    <%= item_form.check_box :is_adult_content, class: "checkbox checkbox-neutral" %>
    <span class="label-text">🔞 成人向け</span>
  </label>
</div>
